# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for custom auth (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=replace-with-a-long-random-string

# Email notifications (server-only — never expose to the browser)
# Gmail SMTP credentials for email worker
# GMAIL_USER: Your Gmail email address
# GMAIL_PASSWORD: Gmail App Password (create at https://myaccount.google.com/apppasswords)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
# Sender address (can be any email, but should match GMAIL_USER for best results)
EMAIL_FROM=your-email@gmail.com
# Coalescing window in minutes: triggers within this window for the same
# recipient fold into one email. Default 10.
EMAIL_BATCH_WINDOW_MINUTES=10
# Email-worker polling cadence in milliseconds. Default 30000 (30s).
WORKER_TICK_MS=30000
# Trash-purge polling cadence in milliseconds (default 3600000 = 1 hour).
PURGE_TICK_MS=3600000
# Days an org stays in the trash before being hard-deleted. Default 5.
PURGE_RETENTION_DAYS=5
