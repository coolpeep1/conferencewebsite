# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for custom auth (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=replace-with-a-long-random-string

# Email notifications (server-only — never expose to the browser)
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Verified sender address in Resend (must be a domain you've verified in the dashboard)
EMAIL_FROM=notifications@yourdomain.com
# Coalescing window in minutes: triggers within this window for the same
# recipient fold into one email. Default 10.
EMAIL_BATCH_WINDOW_MINUTES=10
# Email-worker polling cadence in milliseconds. Default 30000 (30s).
WORKER_TICK_MS=30000
# Postgres connection string for the email worker (use Supabase pooler URL,
# port 6543, transaction mode). Different from the Next.js server connection.
DATABASE_URL=postgresql://postgres:password@your-project-ref.pooler.supabase.com:6543/postgres